# EditorConfig — https://editorconfig.org
# Matches Frappe conventions: tab indentation for Python, LF line endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.py]
indent_style = tab
indent_size = 4

[*.{js,jsx,ts,tsx,css,scss,less,html,vue}]
indent_style = tab
indent_size = 4

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.toml]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.sh]
indent_style = tab
indent_size = 4
